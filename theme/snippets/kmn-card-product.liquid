<a class="kmn-card" href="{{ product.url }}"><div class="kmn-card__image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '240, 400, 600, 800', sizes: '(min-width: 850px) 25vw, 50vw' }}{% endif %}</div><p class="kmn-card__category">{{ product.type | escape }}</p><h3>{{ product.title | escape }}</h3><p class="kmn-card__detail">{{ product.price | money }}{% if cart.taxes_included %}{{ 'kmn.text_257' | t }}{% endif %}{% unless product.available %}{{ 'kmn.text_258' | t }}{% endunless %}</p></a>
<header class="kmn-header"><div class="kmn-header__inner">
<a href="{{ routes.root_url }}" aria-label="{{ 'kmn.text_43' | t | escape }}"><span class="kmn-logo" role="img" aria-label="{{ 'kmn.text_43' | t | escape }}"></span></a>
<nav aria-label="{{ 'kmn.text_50' | t | escape }}"><a href="{{ routes.root_url }}#new-arrivals">{{ 'kmn.text_0' | t }}</a><a href="{{ routes.root_url }}#gallery">{{ 'kmn.text_1' | t }}</a><a href="{{ routes.root_url }}#craft">{{ 'kmn.text_69' | t }}</a><a class="kmn-button" href="{{ routes.all_products_collection_url }}">{{ 'kmn.text_73' | t }}</a></nav>
<div class="kmn-header__actions">{% if localization.available_languages.size > 1 %}{% form 'localization', id: 'KMNLanguage' %}<select name="locale_code" aria-label="Language" onchange="this.form.submit()">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name }}</option>{% endfor %}</select>{% endform %}{% endif %}<a class="kmn-icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'kmn.text_53' | t | escape }}"><img class="kmn-arrow" src="{{ 'icon-cart-empty.svg' | asset_url }}" width="24" height="24" alt="" aria-hidden="true"></a><button class="kmn-icon-button kmn-menu-button" data-menu-open aria-label="{{ 'kmn.text_54' | t | escape }}" aria-expanded="false" aria-controls="kmn-menu"><img class="kmn-arrow" src="{{ 'icon-hamburger.svg' | asset_url }}" width="24" height="24" alt="" aria-hidden="true"></button></div>
</div></header>
<div class="kmn kmn-drawer" id="kmn-menu" hidden><div class="kmn-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'kmn.text_56' | t | escape }}"><div class="kmn-drawer__head"><span class="kmn-logo" role="img" aria-label="{{ 'kmn.text_43' | t | escape }}"></span><button class="kmn-icon-button" data-menu-close aria-label="{{ 'kmn.text_55' | t | escape }}"><img class="kmn-arrow" src="{{ 'icon-close.svg' | asset_url }}" width="24" height="24" alt="" aria-hidden="true"></button></div><nav><a href="{{ routes.root_url }}#new-arrivals">{{ 'kmn.text_0' | t }}</a><a href="{{ routes.root_url }}#gallery">{{ 'kmn.text_1' | t }}</a><a href="{{ routes.root_url }}#craft">{{ 'kmn.text_69' | t }}</a><a href="{{ routes.root_url }}#contact">{{ 'kmn.text_72' | t }}</a><a class="kmn-button" href="{{ routes.all_products_collection_url }}">{{ 'kmn.text_73' | t }}<img class="kmn-arrow" src="{{ 'icon-arrow.svg' | asset_url }}" width="24" height="24" alt="" aria-hidden="true"></a></nav></div></div>
{% schema %}{"name":"KM Header","settings":[]}{% endschema %}